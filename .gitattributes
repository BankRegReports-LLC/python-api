# Normalize line endings — text files are LF in the repo, deterministic builds.
* text=auto eol=lf

# Explicitly text
*.py    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.html  text eol=lf
*.json  text eol=lf
LICENSE text eol=lf

# Binary (never normalize)
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.whl   binary
*.gz    binary
